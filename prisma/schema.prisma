generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                  Int                  @id @default(autoincrement())
  name                String
  slug                String               @unique
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  isDeleted           Boolean              @default(false)
  nextSequence        Int                  @default(1)
  expireAt            DateTime?
  startAt             DateTime?
  admins              Admin[]
  doctors             Doctor[]
  interpretationRules InterpretationRule[]
  parameters          Parameter[]
  registrations       Registration[]
  tests               Test[]
  testFormulas        TestFormula[]
  testParameters      TestParameter[]
  users               User[]
  aiUsages            WorkspaceAiUsage[]
  payments            WorkspacePayment[]
  pdfSetting          WorkspacePdf?
}

model WorkspacePayment {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  amount      Decimal   @default(0.00) @db.Decimal(10, 2)
  days        Int
  paymentMode String    @default("Cash")
  referenceNo String?
  notes       String?   @db.Text
  paidAt      DateTime  @default(now())
  startAt     DateTime?
  expireAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([paidAt])
}

model SuperAdmin {
  id        Int                  @id @default(autoincrement())
  name      String
  email     String               @unique
  password  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  sessions  SuperAdminSession[]
  trackings SuperAdminTracking[]
}

model SuperAdminSession {
  id           Int        @id @default(autoincrement())
  superAdminId Int
  token        String     @unique @db.VarChar(500)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId], map: "SuperAdminSession_superAdminId_fkey")
}

model User {
  id                       Int           @id @default(autoincrement())
  name                     String
  email                    String        @unique
  password                 String?
  provider                 String        @default("credentials")
  googleId                 String?       @unique
  roleId                   Int           @default(2)
  isEmailVerified          Boolean       @default(false)
  isApproved               Boolean       @default(false)
  rejected                 Boolean       @default(false)
  verificationToken        String?       @db.VarChar(255)
  verificationTokenExpires DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  workspaceId              Int?
  role                     UserRole      @relation(fields: [roleId], references: [id])
  workspace                Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions                 UserSession[]

  @@index([roleId], map: "User_roleId_fkey")
  @@index([workspaceId], map: "User_workspaceId_fkey")
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "UserSession_userId_fkey")
}

model UserRole {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  users       User[]
  permissions UserRolePermission[]
}

model UserRolePermission {
  id         Int      @id @default(autoincrement())
  roleId     Int
  permission String
  role       UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model Admin {
  id                         Int                @id @default(autoincrement())
  name                       String
  email                      String             @unique
  password                   String
  provider                   String             @default("credentials")
  roleId                     Int                @default(1)
  isEmailVerified            Boolean            @default(true)
  isApproved                 Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  footerMargin               Int                @default(100)
  framePdfUrl                String?            @db.VarChar(500)
  headerMargin               Int                @default(140)
  useFrameDefault            Boolean            @default(true)
  isActive                   Boolean            @default(true)
  workspaceId                Int?
  authorizedSignatoryDegree1 String?
  authorizedSignatoryDegree2 String?
  authorizedSignatoryName1   String?
  authorizedSignatoryName2   String?
  companyName                String?
  mobileNumber               String?
  role                       AdminRole          @relation(fields: [roleId], references: [id])
  workspace                  Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  address                    AdminAddress?
  sessions                   AdminSession[]
  trackings                  AdminTracking[]
  registrations              Registration[]     @relation("AdminRegistrations")
  aiUsages                   WorkspaceAiUsage[]

  @@index([roleId])
  @@index([workspaceId], map: "Admin_workspaceId_fkey")
}

model AdminSession {
  id        Int      @id @default(autoincrement())
  adminId   Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "AdminSession_adminId_fkey")
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  deletedAt   DateTime?
  isDeleted   Boolean               @default(false)
  admins      Admin[]
  permissions AdminRolePermission[]
}

model AdminRolePermission {
  id         Int       @id @default(autoincrement())
  roleId     Int
  permission String
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model Doctor {
  id                  Int               @id @default(autoincrement())
  name                String
  code                String?
  lastPaid            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspaceId         Int?
  incentivePercent    Decimal           @default(0.00) @db.Decimal(5, 2)
  address             String?
  clinicName          String?
  degree              String?
  deletedAt           DateTime?
  isDeleted           Boolean           @default(false)
  workspace           Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incentiveHistory    DoctorIncentive[]
  registrations       Registration[]    @relation("RefBy")
  secondRegistrations Registration[]    @relation("SecondRef")

  @@unique([workspaceId, code])
}

model Test {
  id                      Int                  @id @default(autoincrement())
  name                    String
  code                    String?
  price                   Decimal              @db.Decimal(10, 2)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  isProcessed             Boolean              @default(false)
  workspaceId             Int?
  deletedAt               DateTime?
  isDeleted               Boolean              @default(false)
  departmentId            Int?
  isCustomized            Boolean              @default(false)
  defaultUpdatedAt        DateTime?
  baseRate                Decimal?             @db.Decimal(10, 2)
  collectionCenterRate    Decimal?             @db.Decimal(10, 2)
  curRate                 Decimal?             @db.Decimal(10, 2)
  franchiseRate           Decimal?             @db.Decimal(10, 2)
  labRate                 Decimal?             @db.Decimal(10, 2)
  offerPrice              Decimal?             @db.Decimal(10, 2)
  rate                    Decimal?             @db.Decimal(10, 2)
  superFranchiseRate      Decimal?             @db.Decimal(10, 2)
  outsourceCost           Decimal?             @default(0.00) @db.Decimal(10, 2)
  specialIncentivePercent Decimal?             @db.Decimal(5, 2)
  interpretationRules     InterpretationRule[]
  registrations           RegistrationTest[]
  department              TestDepartment?      @relation(fields: [departmentId], references: [id])
  workspace               Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formulas                TestFormula[]
  parameters              TestParameter[]

  @@unique([workspaceId, code])
  @@index([departmentId])
}

model Registration {
  id                        Int                   @id @default(autoincrement())
  billOn                    String                @default("Patient Rate")
  mobileNo                  String
  labId                     String
  regNo                     String                @unique
  date                      DateTime              @default(now())
  title                     String
  name                      String
  city                      String                @default("-NA-")
  age                       Float
  ageUnit                   String                @default("Year")
  gender                    String
  refById                   Int?
  secondRefId               Int?
  remark                    String?               @db.Text
  colType                   String                @default("Camp")
  expRptDate                DateTime?
  sampleDate                DateTime?
  sampleNo                  String?
  sampleBy                  String                @default("-NA-")
  paymentMode               String                @default("Cash")
  paymentRefNo              String?
  totalAmount               Decimal               @default(0.00) @db.Decimal(10, 2)
  collectionCharge          Decimal               @default(0.00) @db.Decimal(10, 2)
  discountPercent           Decimal               @default(0.00) @db.Decimal(10, 2)
  discountAmount            Decimal               @default(0.00) @db.Decimal(10, 2)
  receivedAmount            Decimal               @default(0.00) @db.Decimal(10, 2)
  dueAmount                 Decimal               @default(0.00) @db.Decimal(10, 2)
  stickerCount              Int                   @default(1)
  barcode                   String?
  status                    String                @default("Pending")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  workspaceId               Int?
  deletedAt                 DateTime?
  isDeleted                 Boolean               @default(false)
  refByIncentivePercent     Decimal               @default(0.00) @db.Decimal(5, 2)
  secondRefIncentivePercent Decimal               @default(0.00) @db.Decimal(5, 2)
  adminId                   Int?
  pdfOtp                    String?               @db.VarChar(10)
  reportedAt                DateTime?
  results                   PatientResult[]
  admin                     Admin?                @relation("AdminRegistrations", fields: [adminId], references: [id])
  refBy                     Doctor?               @relation("RefBy", fields: [refById], references: [id])
  secondRef                 Doctor?               @relation("SecondRef", fields: [secondRefId], references: [id])
  workspace                 Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments                  RegistrationPayment[]
  tests                     RegistrationTest[]
  aiUsages                  WorkspaceAiUsage[]

  @@unique([workspaceId, labId])
  @@index([date])
  @@index([reportedAt])
  @@index([mobileNo])
  @@index([refById], map: "Registration_refById_fkey")
  @@index([secondRefId], map: "Registration_secondRefId_fkey")
  @@index([workspaceId])
  @@index([adminId])
}

model RegistrationTest {
  registrationId          Int
  testId                  Int
  assessNo                String?
  collectedBy             String       @default("-NA-")
  expense                 Decimal      @default(0.00) @db.Decimal(10, 2)
  pathologist             String       @default("-NA-")
  product                 String       @default("-NA-")
  sampleBarcode           String?
  sampleRemark            String?
  sampleStatus            String       @default("Pending")
  sendTo                  String       @default("-NA-")
  interpretation          String?      @db.Text
  price                   Decimal      @default(0.00) @db.Decimal(10, 2)
  specialIncentivePercent Decimal?     @db.Decimal(5, 2)
  registration            Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  test                    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([registrationId, testId])
  @@index([testId], map: "RegistrationTest_testId_fkey")
}

model Parameter {
  id                      Int                  @id @default(autoincrement())
  name                    String
  unit                    String?
  minValMale              Float?
  maxValMale              Float?
  normalRangeMale         String?
  minValFemale            Float?
  maxValFemale            Float?
  normalRangeFemale       String?
  minValBaby              Float?
  maxValBaby              Float?
  normalRangeBaby         String?
  normalRangeDefault      String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  workspaceId             Int?
  code                    String?
  criticalMaxValBaby      Float?
  criticalMaxValDefault   Float?
  criticalMaxValFemale    Float?
  criticalMaxValMale      Float?
  criticalMinValBaby      Float?
  criticalMinValDefault   Float?
  criticalMinValFemale    Float?
  criticalMinValMale      Float?
  borderlineMaxValBaby    Float?
  borderlineMaxValDefault Float?
  borderlineMaxValFemale  Float?
  borderlineMaxValMale    Float?
  borderlineMinValBaby    Float?
  borderlineMinValDefault Float?
  borderlineMinValFemale  Float?
  borderlineMinValMale    Float?
  options                 String?              @db.Text
  valueType               String?              @default("NUMERIC")
  interpretationRules     InterpretationRule[]
  workspace               Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testFormulas            TestFormula[]
  testMappings            TestParameter[]

  @@unique([workspaceId, name])
  @@index([workspaceId], map: "Parameter_workspaceId_fkey")
}

model TestParameter {
  id             Int             @id @default(autoincrement())
  testId         Int
  order          Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean         @default(false)
  parameterId    Int
  workspaceId    Int?
  decimalPlace   Int             @default(2)
  editable       Boolean         @default(true)
  isCalculated   Boolean         @default(false)
  unit           String?
  roundingMethod String          @default("HALF_UP")
  section        String?
  isHeader       Boolean         @default(false)
  parentId       Int?
  options        String?         @db.Text
  valueType      String?
  results        PatientResult[]
  parameter      Parameter       @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([parameterId], map: "TestParameter_parameterId_fkey")
  @@index([testId], map: "TestParameter_testId_fkey")
  @@index([workspaceId], map: "TestParameter_workspaceId_fkey")
}

model PatientResult {
  id              Int           @id @default(autoincrement())
  registrationId  Int
  testParameterId Int
  value           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  flag            String?
  interpretation  String?       @db.Text
  registration    Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  testParameter   TestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)

  @@unique([registrationId, testParameterId])
  @@index([testParameterId], map: "PatientResult_testParameterId_fkey")
}

model Lead {
  id        Int      @id @default(autoincrement())
  contact   String   @unique
  type      String
  createdAt DateTime @default(now())
}

model AdminAddress {
  id        Int      @id @default(autoincrement())
  address1  String?
  address2  String?
  city      String?
  state     String?
  pincode   String?
  country   String?
  adminId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  latitude  Float?
  longitude Float?
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model RegistrationPayment {
  id             Int          @id @default(autoincrement())
  registrationId Int
  amount         Decimal      @db.Decimal(10, 2)
  paymentMode    String       @default("Cash")
  paymentRefNo   String?
  remark         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId], map: "RegistrationPayment_registrationId_fkey")
}

model LeadContact {
  id           Int       @id @default(autoincrement())
  name         String
  emailOrPhone String
  message      String?   @db.Text
  isRead       Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminTracking {
  id            Int      @id @default(autoincrement())
  sessionId     String   @unique
  startUTC      DateTime
  ENDUTC        DateTime
  mode          String
  durationInMin Float
  adminId       Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admin         Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "AdminTracking_adminId_fkey")
}

model SuperAdminTracking {
  id            Int         @id @default(autoincrement())
  sessionId     String      @unique
  startUTC      DateTime
  ENDUTC        DateTime
  mode          String
  durationInMin Float
  superAdminId  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  superAdmin    SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId], map: "SuperAdminTracking_superAdminId_fkey")
}

model TestDepartment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests     Test[]
}

model TestFormula {
  id                Int        @id @default(autoincrement())
  workspaceId       Int?
  testId            Int
  outputParameterId Int
  formula           String     @db.Text
  description       String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  isActive          Boolean    @default(true)
  name              String?
  version           Int        @default(1)
  outputParameter   Parameter  @relation(fields: [outputParameterId], references: [id], onDelete: Cascade)
  test              Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, testId, outputParameterId])
  @@index([testId])
  @@index([outputParameterId])
  @@index([workspaceId])
}

model InterpretationRule {
  id             Int        @id @default(autoincrement())
  workspaceId    Int?
  testId         Int
  parameterId    Int
  condition      String     @db.Text
  interpretation String     @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  parameter      Parameter  @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  test           Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([parameterId])
  @@index([workspaceId])
}

model DoctorIncentive {
  id               Int      @id @default(autoincrement())
  doctorId         Int
  incentivePercent Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model WorkspacePdf {
  id                         Int       @id @default(autoincrement())
  workspaceId                Int       @unique
  framePdfUrl                String?   @db.VarChar(500)
  useFrameDefault            Boolean   @default(true)
  headerMargin               Int       @default(140)
  footerMargin               Int       @default(100)
  leftMargin                 Int       @default(45)
  rightMargin                Int       @default(45)
  primaryColor               String    @default("#0f766e")
  headerBgColor              String    @default("#e2e8f0")
  headerTextColor            String    @default("#1e293b")
  textColor                  String    @default("#0f172a")
  patientCardBgColor         String    @default("#f8fafc")
  patientCardBorderColor     String    @default("#e2e8f0")
  tableRowBorderColor        String    @default("#e2e8f0")
  departmentTextColor        String    @default("#ffffff")
  fontFamily                 String    @default("Helvetica")
  headerFontSize             Float     @default(9)
  parameterFontSize          Float     @default(8.5)
  patientInfoFontSize        Float     @default(9)
  departmentFontSize         Float     @default(9.5)
  remarkFontSize             Float     @default(8.5)
  columnOrder                String?   @db.Text
  authorizedSignatoryName1   String?
  authorizedSignatoryDegree1 String?
  authorizedSignatoryName2   String?
  authorizedSignatoryDegree2 String?
  showSignatures             Boolean   @default(true)
  showQrCode                 Boolean   @default(true)
  showDepartmentBanner       Boolean   @default(true)
  showPatientBox             Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceAiUsage {
  id              Int           @id @default(autoincrement())
  workspaceId     Int
  adminId         Int?
  registrationId  Int?
  feature         String        @default("RESULT_SUGGESTION")
  model           String?
  prompt          String?       @db.Text
  response        String?       @db.Text
  promptTokens    Int?          @default(0)
  candidateTokens Int?          @default(0)
  totalTokens     Int?          @default(0)
  status          String        @default("SUCCESS")
  errorMessage    String?       @db.Text
  durationMs      Int?
  ipAddress       String?
  createdAt       DateTime      @default(now())
  admin           Admin?        @relation(fields: [adminId], references: [id])
  registration    Registration? @relation(fields: [registrationId], references: [id])
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([adminId])
  @@index([registrationId])
  @@index([createdAt])
  @@index([status])
  @@index([feature])
}

model AppVersion {
  id          Int      @id @default(autoincrement())
  version     String   @unique
  title       String
  description String?  @db.Text
  changes     String?  @db.Text
  isMandatory Boolean  @default(false)
  isActive    Boolean  @default(true)
  releaseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

